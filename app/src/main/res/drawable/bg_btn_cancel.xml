<?xml version="1.0" encoding="utf-8"?>
<!--
    Cancel button uses the SAME lavender as item_note.xml (#E8DEFF).
    This is intentional: Cancel returns the user to the safe, familiar
    note-taking world, so it borrows the note card's own color.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#E8DEFF" />

    <stroke
        android:width="2.5dp"
        android:color="#2B1D5E" />

    <corners android:radius="14dp" />

</shape>