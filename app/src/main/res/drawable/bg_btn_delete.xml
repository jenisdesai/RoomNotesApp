<?xml version="1.0" encoding="utf-8"?>
<!--
    Delete button uses the same coral as the warning badge (#FFB4A8) but
    deeper/more saturated to read as the primary destructive action.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#FF7A6B" />

    <stroke
        android:width="2.5dp"
        android:color="#2B1D5E" />

    <corners android:radius="14dp" />

</shape>