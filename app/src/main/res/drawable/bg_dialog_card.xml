<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_dialog_card.xml

    The actual dialog surface. Off-white/cream fill (not pure white — keeps
    it warm and consistent with the lavender-family palette) with a thick
    3dp solid border in the same deep purple used for note titles
    (#2B1D5E). The thick border + flat fill + zero blur is what reads as
    Neubrutalist rather than standard Material dialog.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#FAF6FF" />

    <stroke
        android:width="3dp"
        android:color="#2B1D5E" />

    <corners android:radius="20dp" />

</shape>