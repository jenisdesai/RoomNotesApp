<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--
        Three-dot overflow menu item.
        "Delete Note" is intentionally placed inside the overflow (not as an action icon)
        so it does NOT appear as an icon in the toolbar.

        Visibility is controlled programmatically:
          - GONE  → when creating a new note (nothing to delete yet)
          - VISIBLE → when editing an existing note

        The actual PopupMenu / dialog logic is wired up in the Fragment/Activity,
        not here. This file only declares the menu structure.
    -->
    <item
        android:id="@+id/action_delete_note"
        android:title="@string/menu_delete_note"
        android:icon="@drawable/ic_delete_24"
        app:showAsAction="never"
        android:visible="false" />

</menu>